# Axora subscription management. Copy to .env and fill in. Placeholders only:
# never put real credentials in this file, and never commit .env.

# MySQL / MariaDB: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (@ → %40, ! → %21, # → %23).
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# Admin dashboard sign-in (the browser asks for it; 12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_long_random_password

PUBLIC_ORIGIN=https://subscription.axorawebsolutions.com
# Behind nginx / a reverse proxy: 1
TRUST_PROXY=1

# Nothing else is needed for the Lead Getter desktop app: its signing key,
# email (SMTP) settings and earlier data are found automatically from an
# earlier Lead Getter licence server on this machine (see README). Set these
# only if there isn't one:
# LICENSE_PRIVATE_KEY=     (the existing key; a new one would break installed apps)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Lead Finder <you@example.com>"
# SUBSCRIPTION_ADMIN_EMAIL=
# PAYMENT_INSTRUCTIONS=

# Initial user for `npm run seed` (optional).
SEED_USER_ID=
SEED_USER_EMAIL=

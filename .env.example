# Axora subscription management. Copy to .env (or set these in your hosting
# panel) and fill in. Placeholders only: never put real credentials in this
# file, and never commit .env.

# --- Database (MySQL / MariaDB, read by Prisma) -----------------------------
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (@ → %40, ! → %21, # → %23,
# : → %3A, / → %2F), e.g.:
#   node -e "console.log(encodeURIComponent(process.argv[1]))" 'your-password'
# For TLS to the database add ?sslaccept=strict
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# --- Admin authorization ---------------------------------------------------
# The browser asks for these when the page opens (no login page). Use a long,
# random password (12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_long_random_password
# Optional: for scripts/tools ("Authorization: Bearer <token>"), 32+ chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
PUBLIC_ORIGIN=https://subscription.axorawebsolutions.com
# Behind a reverse proxy / cPanel / Passenger: 1 (number of proxies in front).
TRUST_PROXY=1
# Apply pending Prisma migrations automatically at startup (prisma migrate deploy).
MIGRATE_ON_START=true

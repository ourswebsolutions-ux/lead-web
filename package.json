{
  "name": "axora-subscription-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Subscription management for Axora Web Solutions (subscription.axorawebsolutions.com).",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "seed": "prisma db seed",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.1.0",
    "prisma": "6.19.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
